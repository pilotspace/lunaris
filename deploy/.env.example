# Copy to `deploy/.env` — docker compose reads it automatically.
# Every value here is the compose default; uncomment only what you change.

# ── Moon ─────────────────────────────────────────────────────────────────────
# Must be >= 0.8.5 (MIN_MOON_VERSION). Tag has NO leading `v`.
#MOON_VERSION=0.8.5
# everysec (default) | always (≈0 RPO, slower) | no
#MOON_APPENDFSYNC=everysec
#MOON_RUST_LOG=moon=info

# ── lunaris-server ───────────────────────────────────────────────────────────
#LUNARIS_STORAGE=moon://moon:6379
#LUNARIS_PORT=8080
#LUNARIS_HTTP_TIMEOUT_SECS=30
#LUNARIS_HTTP_CONCURRENCY=256
#LUNARIS_SHUTDOWN_GRACE_SECS=30
#LUNARIS_STOP_GRACE=40s
#LUNARIS_MOON_OP_TIMEOUT=10
#LUNARIS_RATE_PER_SECOND=60
#LUNARIS_RATE_BURST=120
#LUNARIS_CORS_ORIGINS=*
#LUNARIS_ENV=production
#LUNARIS_RUST_LOG=lunaris=info,lunaris_server=info

# ── Host paths (compose does NOT expand `~`) ─────────────────────────────────
# Directory holding the two GGUFs. Default is ./models relative to deploy/.
#LUNARIS_MODELS_DIR=/absolute/path/to/.lunaris/models
#LUNARIS_EMBEDDER_GGUF_NAME=granite-embedding-311m-multilingual-r2.Q4_K_M.gguf
#LUNARIS_RERANKER_GGUF_NAME=bge-reranker-v2-m3.Q5_K_M.gguf
#LUNARIS_TOKENS_FILE_HOST=./tokens.json

# ── Build ────────────────────────────────────────────────────────────────────
# `lunaris/llamacpp` = real embedder + reranker (needs cmake/C++ in the
# builder). Set to an empty value ONLY for a Tier-0 no-inference build, which
# returns zero rows from every vector recall.
#LUNARIS_BUILD_FEATURES=lunaris/llamacpp

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["index.d.ts", "lunaris.d.ts", "__test__/**/*"],
  // `__test__/readme_quickstart.ts` imports the package by NAME; only
  // tsconfig.readme.json maps that specifier, so it is checked there.
  "exclude": ["dist", "node_modules", "target", "npm", "__test__/readme_quickstart.ts"]
}
